generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The User entity represents a user in the system.
model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  emailVerified          DateTime?
  name                   String?
  image                  String?
  passwordHash           String?
  role                   String               @default("USER") // USER, ADMIN, TESTER, VIEWER
  githubId               String?              @unique
  githubUsername         String?
  githubAccessToken      String?
  githubEmail            String?
  avatarUrl              String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  organisationMembers    OrganisationMember[] @relation("organisationMembers")
  projectMembers         ProjectMember[]      @relation("projectMembers")
  ownedTestCases         TestCase[]           @relation("TestCase_owner")
  ownedEnvironments      Environment[]        @relation("Environment_owner")
  testExecutionsAsTester TestExecution[]      @relation("TestExecution_tester")
  reportedDefects        Defect[]             @relation("Defect_reporter")
  assignedDefects        Defect[]             @relation("Defect_assignee")
  testPlanCases          TestPlanCase[]       @relation("TestPlanCase_assignee")
  auditLogs              AuditLog[]           @relation("auditLogs")
  attachments            Attachment[]         @relation("attachments")
  passwordResetTokens    PasswordResetToken[] @relation("passwordResetTokens")
  testCaseVersions       TestCaseVersion[]    @relation("TestCaseVersion_changedBy")
  ownedRequirements      Requirement[]        @relation("Requirement_owner")
  userSettings           UserSettings?        @relation("UserSettings_user")
  invitedTestCases       TestCase[]           @relation("TestCase_reviewer")
  invitationTokens       InvitationToken[]    @relation("invitationTokens_creator")
  projectInvitations     ProjectInvitation[]  @relation("projectInvitations_invitee")
  createdInvitations     ProjectInvitation[]  @relation("ProjectInvitation_creator")
}

/// An Organisation is a tenant that owns projects.
model Organisation {
  id           String               @id @default(cuid())
  name         String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      OrganisationMember[] @relation("organisationMembers")
  projects     Project[]            @relation("Project_organisation")
  teamSettings TeamSetting[]        @relation("TeamSetting_organisation")
}

/// The OrganisationMember model connects users to organisations with a role.
model OrganisationMember {
  id             String       @id @default(cuid())
  user           User         @relation("organisationMembers", fields: [userId], references: [id])
  userId         String
  organisation   Organisation @relation("organisationMembers", fields: [organisationId], references: [id])
  organisationId String
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organisationId])
}

/// A Project belongs to an organisation and contains test cases, plans, etc.
model Project {
  id                     String                  @id @default(cuid())
  name                   String
  description            String?
  organisation           Organisation            @relation("Project_organisation", fields: [organisationId], references: [id])
  organisationId         String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                ProjectMember[]         @relation("projectMembers")
  roles                  ProjectRole[]           @relation("ProjectRole_project")
  invitations            ProjectInvitation[]     @relation("ProjectInvitation_project")
    testCases              TestCase[]              @relation("TestCase_project")
  testPlans              TestPlan[]              @relation("TestPlan_project")
  requirements           Requirement[]           @relation("Requirement_project")
  apiCollections         ApiCollection[]         @relation("ApiCollection_project")
  thirdPartyIntegrations ThirdPartyIntegration[] @relation("ThirdPartyIntegration_project")
  allureReports          AllureReport[]          @relation("AllureReport_project")
  ciRuns                 CiRun[]                 @relation("CiRun_project")
  environments           Environment[]           @relation("Environment_project")
  qualityGates           QualityGate[]           @relation("QualityGate_project")
}

/// The ProjectMember model connects users to projects with a role.
model ProjectMember {
  id        String   @id @default(cuid())
  user      User     @relation("projectMembers", fields: [userId], references: [id])
  userId    String
  project   Project  @relation("projectMembers", fields: [projectId], references: [id])
  projectId String
  role      String   @default("MEMBER") // OWNER, MANAGER, TESTER, VIEWER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
}

/// A QualityGate that must be satisfied before a workflow stage transition.
model QualityGate {
  id               String   @id @default(cuid())
  name             String
  description      String?
  stage            String   @default("SUBMIT") // DRAFT, SUBMIT, APPROVE, EXECUTE, RELEASE
  rules            String   @default("[]") // JSON array of rule definitions
  isActive         Boolean  @default(true)
  isBlocking       Boolean  @default(true)
  project          Project  @relation("QualityGate_project", fields: [projectId], references: [id])
  projectId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, name])
}

/// An Environment represents a managed test environment (dev/QA/staging/prod).
model Environment {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("QA") // DEVELOPMENT, QA, STAGING, PRODUCTION, CUSTOM
  baseUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE, ARCHIVED
  project     Project  @relation("Environment_project", fields: [projectId], references: [id])
  projectId   String
  owner       User?    @relation("Environment_owner", fields: [ownerId], references: [id])
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
}

/// A TestCase represents a manual test case.
model TestCase {
  id                String                @id @default(cuid())
  key               String                @unique
  title             String
  description       String?
  objective         String?
  preconditions     String?
  testData          String?
  testType          String? // e.g. "FUNCTIONAL", "UI", "API", "DATABASE", "PERFORMANCE", "SECURITY", "ACCESSIBILITY"
  testLevel         String? // UNIT, INTEGRATION, SYSTEM, ACCEPTANCE
  testTechnique     String? // Equivalence partitioning, boundary-value analysis, decision tables, state transitions, etc.
  gherkinText       String? // Gherkin scenario text for BDD tests
  priority          String                @default("MEDIUM")
  severity          String                @default("MEDIUM")
  status            String                @default("DRAFT")
  automationStatus  String                @default("MANUAL") // MANUAL, AUTOMATED, CANDIDATE, NOT_SUITABLE
  automationScriptLink String?
  testEnvironment   String? // DEVELOPMENT, QA, STAGING, PRODUCTION
  component         String?
  labels            String[] // We'll use a string array for labels; in Postgres we can use text[]
  owner             User                  @relation("TestCase_owner", fields: [ownerId], references: [id])
  ownerId           String
  reviewer          User?                 @relation("TestCase_reviewer", fields: [reviewerId], references: [id])
  reviewerId        String?
  project           Project               @relation("TestCase_project", fields: [projectId], references: [id])
  projectId         String
  requirementLinks  RequirementTestCase[] @relation("RequirementTestCase_testCase")
  testSuiteId       String?
  estimatedDuration Int? // in minutes
  actualResult      String?
  steps             TestStep[]            @relation("TestStep_testCase")
  executions        TestExecution[]       @relation("TestExecution_testCase")
  defects           Defect[]              @relation("Defect_testCase")
  planCases         TestPlanCase[]        @relation("TestPlanCase_testCase")
  attachments       Attachment[]          @relation("testCaseAttachments")
  versions          TestCaseVersion[]     @relation("TestCaseVersion_testCase")
  parameters        TestParameter[]       @relation("TestParameter_testCase")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

/// A TestStep represents a step within a test case.
model TestStep {
  id             String           @id @default(cuid())
  testCase       TestCase         @relation("TestStep_testCase", fields: [testCaseId], references: [id])
  testCaseId     String
  action         String
  expectedResult String
  data           String?
  attachments    String[]
  position       Int
  results        TestStepResult[] @relation("TestStepResult_testStep")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([testCaseId, position])
}

/// A TestExecution represents a single execution of a test case (manual or automated).
model TestExecution {
  id           String           @id @default(cuid())
  testCase     TestCase         @relation("TestExecution_testCase", fields: [testCaseId], references: [id])
  testCaseId   String
  status       String           @default("NOT_RUN")
  actualResult String?
  tester       User             @relation("TestExecution_tester", fields: [testerId], references: [id])
  testerId     String
  environment  String?
  build        String?
  startedAt    DateTime?
  endedAt      DateTime?
  stepResults  TestStepResult[] @relation("TestStepResult_testExecution")
  defects      Defect[]         @relation("Defect_testExecution")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// A TestStepResult represents the result of a specific step in a test execution.
model TestStepResult {
  id              String        @id @default(cuid())
  testExecution   TestExecution @relation("TestStepResult_testExecution", fields: [testExecutionId], references: [id])
  testExecutionId String
  testStep        TestStep      @relation("TestStepResult_testStep", fields: [testStepId], references: [id])
  testStepId      String
  status          String        @default("NOT_RUN")
  actualResult    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

/// A Defect represents a bug or issue found during testing.
model Defect {
  id                String         @id @default(cuid())
  title             String
  description       String?
  stepsToReproduce  String?
  expectedResult    String?
  actualResult      String?
  severity          String         @default("MEDIUM")
  priority          String         @default("MEDIUM")
  status            String         @default("OPEN")
  testCase          TestCase?      @relation("Defect_testCase", fields: [testCaseId], references: [id])
  testCaseId        String?
  testExecution     TestExecution? @relation("Defect_testExecution", fields: [testExecutionId], references: [id])
  testExecutionId   String?
  reporter          User           @relation("Defect_reporter", fields: [reporterId], references: [id])
  reporterId        String
  assignee          User?          @relation("Defect_assignee", fields: [assigneeId], references: [id])
  assigneeId        String?
  environment       String?
  build             String?
  externalTicketId  String?
  externalTicketUrl String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

/// A TestPlan represents a collection of test cases for a specific purpose (e.g., sprint, release).
model TestPlan {
  id          String      @id @default(cuid())
  name        String
  description String?
  project     Project     @relation("TestPlan_project", fields: [projectId], references: [id])
  projectId   String
  scope       String?
  objectives  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  suites      TestSuite[] @relation("TestSuite_testPlan")
}

/// A TestSuite is a group within a test plan.
model TestSuite {
  id          String         @id @default(cuid())
  name        String
  description String?
  testPlan    TestPlan       @relation("TestSuite_testPlan", fields: [testPlanId], references: [id])
  testPlanId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cases       TestPlanCase[] @relation("TestPlanCase_testSuite")
}

/// A TestPlanCase is a join table that links a test case to a test suite (and thus a test plan).
model TestPlanCase {
  id          String    @id @default(cuid())
  testSuite   TestSuite @relation("TestPlanCase_testSuite", fields: [testSuiteId], references: [id])
  testSuiteId String
  testCase    TestCase  @relation("TestPlanCase_testCase", fields: [testCaseId], references: [id])
  testCaseId  String
  position    Int
  assignedTo  User?     @relation("TestPlanCase_assignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([testSuiteId, testCaseId])
}

/// Email verification token. One-time use, expires after a set window.
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String // email address
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Password reset token. One-time use, expires after a set window.
model PasswordResetToken {
  id         String   @id @default(uuid())
  identifier String // email address
  token      String   @unique
  expires    DateTime
  user       User     @relation("passwordResetTokens", fields: [userId], references: [id])
  userId     String

  @@unique([identifier, token])
}

/// Immutable audit log entry for security-sensitive operations.
model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation("auditLogs", fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String // e.g. "USER.REGISTER", "USER.LOGIN", "TEST_CASE.CREATE"
  entity    String? // e.g. "TestCase", "Project"
  entityId  String?
  metadata  Json? // safe, non-sensitive details
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

/// File attachment uploaded as evidence for a test case or execution.
model Attachment {
  id           String    @id @default(uuid())
  filename     String // stored filesystem name
  originalName String
  mimeType     String
  size         Int // bytes
  path         String // storage path
  uploadedBy   User      @relation("attachments", fields: [uploadedById], references: [id])
  uploadedById String
  testCase     TestCase? @relation("testCaseAttachments", fields: [testCaseId], references: [id])
  testCaseId   String?
  createdAt    DateTime  @default(now())
}

/// A TestCaseVersion represents a snapshot of a test case at a point in time.
model TestCaseVersion {
  id            String   @id @default(uuid())
  testCase      TestCase @relation("TestCaseVersion_testCase", fields: [testCaseId], references: [id])
  testCaseId    String
  version       Int
  key           String
  title         String
  description   String?
  objective     String?
  preconditions String?
  priority      String
  status        String
  component     String?
  testType      String?
  gherkinText   String?
  changedBy     User?    @relation("TestCaseVersion_changedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedById   String?
  changedAt     DateTime @default(now())
}

/// A Requirement represents a business or functional requirement.
model Requirement {
  id                 String                          @id @default(cuid())
  key                String                          @unique
  title              String
  description        String?
  type               String                          @default("FUNCTIONAL")
  priority           String                          @default("MEDIUM")
  status             String                          @default("DRAFT")
  owner              User                            @relation("Requirement_owner", fields: [ownerId], references: [id])
  ownerId            String
  project            Project                         @relation("Requirement_project", fields: [projectId], references: [id])
  projectId          String
  testCases          RequirementTestCase[]           @relation("RequirementTestCase_requirement")
  acceptanceCriteria RequirementAcceptanceCriteria[] @relation("RequirementAcceptanceCriteria_requirement")
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
}

/// Links a requirement to one or more test cases for traceability.
model RequirementTestCase {
  id            String      @id @default(cuid())
  requirement   Requirement @relation("RequirementTestCase_requirement", fields: [requirementId], references: [id])
  requirementId String
  testCase      TestCase    @relation("RequirementTestCase_testCase", fields: [testCaseId], references: [id])
  testCaseId    String

  @@unique([requirementId, testCaseId])
}

/// Acceptance criteria belonging to a requirement.
model RequirementAcceptanceCriteria {
  id            String      @id @default(cuid())
  requirement   Requirement @relation("RequirementAcceptanceCriteria_requirement", fields: [requirementId], references: [id])
  requirementId String
  text          String
  position      Int
  createdAt     DateTime    @default(now())
}

/// User-specific settings persisted per user.
model UserSettings {
  id                      String   @id @default(cuid())
  user                    User     @relation("UserSettings_user", fields: [userId], references: [id], onDelete: Cascade)
  userId                  String   @unique
  aiEnabled               Boolean  @default(true)
  autoComplete            String   @default("OFF")
  confidenceThreshold     Int      @default(80)
  retentionDays           Int      @default(90)
  minPassRate             Int      @default(90)
  blockOnCriticalFailures Boolean  @default(true)
  aiProvider              String?  @default("gemini")
  aiModel                 String?  @default("gemini-flash-lite-latest")
  integrationConfigs      Json? // Stores Jira, Azure DevOps, Trello connection details
  updatedAt               DateTime @updatedAt
}

/// Project-level role definitions (stored as strings for flexibility).
/// Roles: OWNER (full access), MANAGER (manage tests/plans/defects),
/// TESTER (create/edit test cases/executions), VIEWER (read-only).
model ProjectRole {
  id          String   @id @default(cuid())
  project     Project  @relation("ProjectRole_project", fields: [projectId], references: [id])
  projectId   String
  name        String // e.g. "OWNER", "MANAGER", "TESTER", "VIEWER"
  permissions String[] // e.g. ["test_case:create", "test_case:edit", "test_plan:delete"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
}

/// Invitations to join a project (email-based, one-time token).
model ProjectInvitation {
  id           String    @id @default(cuid())
  project      Project   @relation("ProjectInvitation_project", fields: [projectId], references: [id])
  projectId    String
  invitee      User?     @relation("projectInvitations_invitee", fields: [inviteeId], references: [id])
  inviteeId    String?
  inviteeEmail String? // For invitees who haven't registered yet
  role         String    @default("TESTER") // OWNER, MANAGER, TESTER, VIEWER
  token        String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  createdBy    User?     @relation("ProjectInvitation_creator", fields: [createdById], references: [id])
  createdById  String?

  @@unique([projectId, inviteeEmail])
}

/// Token for email-based registration invitations.
model InvitationToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  role      String   @default("USER")
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)
  createdBy User?    @relation("invitationTokens_creator", fields: [creatorId], references: [id])
  creatorId String?
}

/// Team-level automation configurations and CI/CD connections.
model TeamSetting {
  id             String        @id @default(cuid())
  organisation   Organisation? @relation("TeamSetting_organisation", fields: [organisationId], references: [id])
  organisationId String?
  key            String // e.g. "default_test_type", "require_review"
  value          String? // JSON string or plain value
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organisationId, key])
}

/// A TestParameter is a named variable/value pair attached to a test case
/// for data-driven testing (e.g. base_url, username, payload fixture).
model TestParameter {
  id          String   @id @default(cuid())
  testCase    TestCase @relation("TestParameter_testCase", fields: [testCaseId], references: [id])
  testCaseId  String
  name        String // parameter name e.g. "base_url", "username", "api_key"
  value       String // parameter value
  description String?
  isRequired  Boolean  @default(false)
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([testCaseId, name])
}

/// An ApiCollection groups related API endpoints (like a Postman collection).
model ApiCollection {
  id          String        @id @default(cuid())
  project     Project       @relation("ApiCollection_project", fields: [projectId], references: [id])
  projectId   String
  name        String
  description String?
  source      String        @default("MANUAL") // MANUAL, POSTMAN, INSOMNIA
  externalId  String? // Postman collection ID, Insomnia export ID, etc.
  externalUrl String? // link to external collection
  endpoints   ApiEndpoint[] @relation("ApiEndpoint_collection")
  monitors    ApiMonitor[]  @relation("ApiMonitor_collection")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// An ApiEndpoint is a single HTTP endpoint to monitor/test.
model ApiEndpoint {
  id                 String             @id @default(cuid())
  collection         ApiCollection      @relation("ApiEndpoint_collection", fields: [collectionId], references: [id])
  collectionId       String
  name               String
  method             String // GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS
  url                String
  headers            Json? // { "Content-Type": "application/json" }
  queryParams        Json? // [{"key": "page", "value": "1"}]
  body               Json? // request body for POST/PUT/PATCH
  authType           String? // NONE, BASIC, BEARER, API_KEY
  authConfig         Json? // { "username": "...", "password": "..." }
  timeout            Int                @default(30000) // ms
  expectedStatusCode Int                @default(200)
  monitors           ApiMonitor[]       @relation("ApiMonitor_endpoint")
  results            ApiMonitorResult[] @relation("ApiMonitorResult_endpoint")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

/// An ApiMonitor schedules recurring checks of API endpoints.
model ApiMonitor {
  id           String          @id @default(cuid())
  collection   ApiCollection   @relation("ApiMonitor_collection", fields: [collectionId], references: [id])
  collectionId String
  endpoint     ApiEndpoint?    @relation("ApiMonitor_endpoint", fields: [endpointId], references: [id])
  endpointId   String?
  name         String
  schedule     String // cron expression e.g. "*/5 * * * *"
  isEnabled    Boolean         @default(true)
  assertions   Json? // [{"path": "statusCode", "operator": "equals", "value": 200}]
  runs         ApiMonitorRun[] @relation("ApiMonitorRun_monitor")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// A single execution of an ApiMonitor.
model ApiMonitorRun {
  id        String             @id @default(cuid())
  monitor   ApiMonitor         @relation("ApiMonitorRun_monitor", fields: [monitorId], references: [id])
  monitorId String
  status    String // PASSED, FAILED, PARTIAL, ERROR
  startedAt DateTime
  endedAt   DateTime?
  duration  Int? // ms
  results   ApiMonitorResult[] @relation("ApiMonitorResult_run")
  createdAt DateTime           @default(now())
}

/// Result of monitoring one endpoint within a monitor run.
model ApiMonitorResult {
  id           String        @id @default(cuid())
  run          ApiMonitorRun @relation("ApiMonitorResult_run", fields: [runId], references: [id])
  runId        String
  endpoint     ApiEndpoint   @relation("ApiMonitorResult_endpoint", fields: [endpointId], references: [id])
  endpointId   String
  status       String // PASSED, FAILED, ERROR
  statusCode   Int?
  responseTime Int? // ms
  responseBody String?
  assertions   Json? // [{"name": "status", "passed": true, "actual": 200, "expected": 200}]
  errorMessage String?
  createdAt    DateTime      @default(now())
}

/// A third-party integration configured for a project (e.g. Postman, Jira).
model ThirdPartyIntegration {
  id           String    @id @default(cuid())
  project      Project   @relation("ThirdPartyIntegration_project", fields: [projectId], references: [id])
  projectId    String
  type         String // POSTMAN, JIRA, AZURE_DEVOPS, TRELLO, SLACK
  name         String
  config       Json? // { apiKey, collectionId, workspaceId, baseUrl, ... }
  isEnabled    Boolean   @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([projectId, type, name])
}

/// A CI/CD pipeline run ingested into TestHub for traceability.
model CiRun {
  id            String        @id @default(cuid())
  project       Project       @relation("CiRun_project", fields: [projectId], references: [id])
  projectId     String
  pipelineId    String // external pipeline ID (GitHub Actions run ID, Jenkins build number, etc.)
  pipelineName  String
  buildNumber   Int
  status        String // PENDING, RUNNING, PASSED, FAILED, CANCELLED
  branch        String
  commitSha     String
  commitMessage String?
  startedAt     DateTime?
  endedAt       DateTime?
  duration      Int? // seconds
  allureReport  AllureReport? @relation("AllureReport_ciRun")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

/// An Allure report ingested from CI/CD for test result traceability.
model AllureReport {
  id           String   @id @default(cuid())
  project      Project  @relation("AllureReport_project", fields: [projectId], references: [id])
  projectId    String
  ciRun        CiRun?   @relation("AllureReport_ciRun", fields: [ciRunId], references: [id])
  ciRunId      String?  @unique
  name         String
  url          String? // link to hosted Allure report
  totalTests   Int
  passedTests  Int
  failedTests  Int
  brokenTests  Int
  skippedTests Int
  duration     Int? // ms
  resultsJson  Json? // raw Allure results JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Audit trail for configuration changes (e.g. role assignments, permission changes).
model ConfigChange {
  id         String   @id @default(cuid())
  action     String // e.g. "ROLE.ASSIGNED", "ROLE.REMOVED", "PERMISSION.UPDATED"
  resource   String // e.g. "Project", "Organisation"
  resourceId String?
  actor      String? // User ID of the actor
  before     Json? // Previous state
  after      Json? // New state
  createdAt  DateTime @default(now())
}
