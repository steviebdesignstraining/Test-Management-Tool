# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Neon Data API and Auth URLs
NEON_DATA_API_URL="https://your-project.apirest.c-6.us-east-2.aws.neon.tech/your-project/rest/v1"
NEON_AUTH_URL="https://your-project.neonauth.c-6.us-east-2.aws.neon.tech/your-project/auth"
NEXT_PUBLIC_NEON_DATA_API_URL="https://your-project.apirest.c-6.us-east-2.aws.neon.tech/your-project/rest/v1"
NEXT_PUBLIC_NEON_AUTH_URL="https://your-project.neonauth.c-6.us-east-2.aws.neon.tech/your-project/auth"
