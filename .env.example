# Copy this file to `.env.local` and replace placeholders with real credentials.
# This file is committed to version control.
# Never commit .env.local or any file with real secrets.

# =============================================================================
# Neon Postgres
# =============================================================================
DATABASE_URL="postgresql://user:password@ep-hostname.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-hostname.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# =============================================================================
# Neon AI Gateway (requires a paid Neon plan; optional)
# =============================================================================
NEON_AI_GATEWAY_URL="https://gateway.neon.tech/ai/v1"
NEON_AI_GATEWAY_API_KEY="your-neon-ai-gateway-api-key"
NEON_API_KEY="your-neon-api-key"

# =============================================================================
# Auth / Session
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-auth-secret"

# =============================================================================
# Application
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# =============================================================================
# SMTP Email (optional in dev; required for real email delivery)
# =============================================================================
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@example.com"

# =============================================================================
# Gemini AI
# =============================================================================
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-lite-latest"

# =============================================================================
# GitHub OAuth / App
# =============================================================================
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3001/api/v1/auth/github/callback"
GITHUB_APP_ID="your-github-app-id"
GITHUB_APP_CLIENT_ID="your-github-app-client-id"
GITHUB_APP_CLIENT_SECRET="your-github-app-client-secret"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nCHANGE_ME\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET="generate-with-openssl-rand-hex-32"

# =============================================================================
# Jira Integration
# =============================================================================
JIRA_BASE_URL="https://your-instance.atlassian.net"
JIRA_EMAIL="you@company.com"
JIRA_API_TOKEN="your-jira-api-token"

# =============================================================================
# Azure DevOps Integration
# =============================================================================
AZURE_DEVOPS_ORGANIZATION_URL="https://dev.azure.com/your-organization"
AZURE_DEVOPS_PERSONAL_ACCESS_TOKEN="your-azure-devops-pat"

# =============================================================================
# Trello Integration
# =============================================================================
TRELLO_API_KEY="your-trello-api-key"
TRELLO_API_TOKEN="your-trello-token"

# =============================================================================
# Object Storage (attachments) - optional
# =============================================================================
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_REGION="us-east-1"
USE_S3="false"

# =============================================================================
# Encryption key for sensitive data (OAuth tokens, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
ENCRYPTION_KEY="your-encryption-key-in-hex"
