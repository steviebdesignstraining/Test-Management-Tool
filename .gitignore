# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# neon
.neon
neon.ts

# prisma
prisma.config.ts
prisma-8.md
# Note: migrations/ is intentionally NOT ignored - commit migration files
# Note: prisma/schema.prisma is kept as a reference schema

# agent / IDE configs
.agents/
.claude/
.cursor/
.devin/
.vscode/

# project-specific build prompt (reference doc, not source)
ai_test_management_platform_build_prompt.md

# temp / debug scripts
test-connection*.js
test-request.js
output.txt

# dist
dist/